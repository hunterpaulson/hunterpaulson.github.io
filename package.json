{
  "name": "hunterpaulson.github.io",
  "version": "0.1.0",
  "description": "Hunter Paulson's personal website",
  "packageManager": "bun@1.3.11",
  "main": "src/index.css",
  "scripts": {
    "dev": "vite",
    "build": "make clean && make SITE_MODE=production DIST_DIR=dist",
    "audit:grid": "bun scripts/grid-audit.mjs",
    "export:media": "bun scripts/export-media.mjs",
    "export:art": "bun scripts/export-media.mjs all-gifs",
    "generate:blackhole:glyphs": "bun scripts/blackhole/generate-glyph-catalog.mjs",
    "generate:blackhole:font": "uv run scripts/blackhole/build-braille-font.py",
    "generate:blackhole:wasm": "make -B assets/blackhole_wasm.js",
    "benchmark:blackhole": "bun scripts/blackhole/run-native-benchmark.mjs",
    "measure:blackhole": "bun scripts/blackhole/measure-browser.mjs",
    "preview": "vite preview",
    "test": "bun test",
    "generate:blog:industrialization:corpus": "bun scripts/blog/industrialization/generate-corpus.mjs"
  },
  "author": "Hunter Paulson",
  "license": "MIT",
  "devDependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prismjs": "^1.30.0",
    "puppeteer-core": "^24.40.0",
    "vite": "^5.4.2"
  }
}
